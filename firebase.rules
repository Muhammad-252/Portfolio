rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Portfolio projects: Public read, admin write
    match /projects/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Blog articles: Public read, admin write
    match /posts/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // FAQs: Public read, admin write
    match /faqs/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Dynamic taxonomies & site settings: Public read, admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /industries/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /categories/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Contact messages: Public submission, admin read/manage
    match /messages/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Newsletter subscribers: Public subscription, admin read/manage
    match /subscribers/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Default fallback: Require authentication
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}